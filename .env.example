# SentinelX AI-SOC Environment Configuration Template
# Duplicate this file to .env and adjust variables as appropriate.

# Application Profile: "demo" (synthetic reproducible telemetry) or "real" (production sensors)
APP_MODE=demo
DEBUG=True

# Database Configuration (defaults to sqlite:///./sentinelx.db for immediate local zero-dependency run)
DATABASE_URL=sqlite:///./sentinelx.db
# DATABASE_URL=postgresql://sentinelx:your_password@localhost:5432/sentinelx_soc

# JWT Secret & Cryptography
SECRET_KEY=replace-with-a-random-64-character-hex-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Wazuh SIEM & EDR Integration
WAZUH_API_URL=https://127.0.0.1:55000
WAZUH_USER=wazuh-wui
WAZUH_PASSWORD=your_wazuh_api_password_here

# Suricata IDS Telemetry
SURICATA_EVE_PATH=sample_data/events/eve.json

# Threat Intelligence Provider API Keys (Optional - demo benchmark returned if empty)
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
ALIENVAULT_OTX_KEY=

# AI Assistant Provider ("local_expert", "ollama", "openai")
AI_PROVIDER=local_expert
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b
